{
  "id": "registrar-namecheap",
  "name": "Namecheap",
  "version": "0.1.0",
  "kind": "registrar",
  "engine": "wasm",
  "provides": "namecheap",
  "abi": "0.2.0",
  "wasm": "addon.wasm",
  "description": "addons.desc.registrar.namecheap",
  "author": "MythicalSystems",
  "permissions": [
    "domains.manage",
    "network.outbound"
  ],
  "capabilities": {
    "http": [
      "api.namecheap.com",
      "api.sandbox.namecheap.com",
      "$setting:api_base"
    ],
    "secrets": []
  },
  "settings": [
    {
      "key": "api_user",
      "label": "addons.registrar.setting.api_user",
      "kind": "text",
      "required": true
    },
    {
      "key": "api_key",
      "label": "addons.registrar.setting.api_key",
      "kind": "secret",
      "required": true
    },
    {
      "key": "username",
      "label": "addons.registrar.setting.username",
      "kind": "text",
      "required": true
    },
    {
      "key": "client_ip",
      "label": "addons.registrar.setting.client_ip",
      "kind": "text",
      "required": true
    },
    {
      "key": "test_mode",
      "label": "addons.registrar.setting.test_mode",
      "kind": "bool",
      "required": false,
      "default": false
    },
    {
      "key": "api_base",
      "label": "addons.registrar.setting.api_base",
      "kind": "text",
      "required": false
    }
  ]
}
